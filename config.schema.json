{
  "pluginAlias": "HueMotionRestore",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "### MotionGuard for Hue v0.8.3 — Branding Refresh\nLive Hue state caching, parallel light writes, precise performance timing, clean Apple Home controls, and refreshed MotionGuard artwork.",
  "footerDisplay": "Existing Apple Home Motion Trigger identities are preserved. v0.8.3 refreshes bundled MotionGuard branding assets with no runtime behavior changes.",
  "x-branding": {
    "imagePath": "branding/banner.png",
    "iconPath": "branding/icon.png",
    "image": "https://raw.githubusercontent.com/Tupling/homebridge-motionguard-hue/main/branding/banner.png",
    "icon": "https://raw.githubusercontent.com/Tupling/homebridge-motionguard-hue/main/branding/icon.png"
  },
  "x-icon": "branding/icon.png",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "bridgeHost",
      "bridgeId",
      "certificateFingerprint",
      "hueApplicationKey"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "MotionGuard for Hue"
      },
      "bridgeHost": {
        "title": "Hue Bridge Private IP",
        "type": "string",
        "placeholder": "192.168.1.25",
        "description": "Private or link-local IP address only."
      },
      "bridgeId": {
        "title": "Hue Bridge ID",
        "type": "string"
      },
      "certificateFingerprint": {
        "title": "Pinned TLS Certificate SHA-256",
        "type": "string"
      },
      "hueApplicationKey": {
        "title": "Hue Application Key",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "lights": {
        "title": "Legacy / Single-Zone Hue Lights",
        "type": "array",
        "description": "Backward-compatible single-zone list. The Dynamic Zone Manager can convert this into a managed zone while preserving the existing Ring Motion Pulse accessory.",
        "items": {
          "title": "Light Name or ID",
          "type": "string"
        }
      },
      "zoneManagerVersion": {
        "title": "Zone Manager Version",
        "type": "integer",
        "default": 2
      },
      "zones": {
        "title": "Motion Lighting Zones",
        "type": "array",
        "items": {
          "title": "Zone",
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "title": "Stable Zone ID",
              "type": "string",
              "description": "Permanent internal ID used to preserve HomeKit accessory identity when the zone is renamed."
            },
            "name": {
              "title": "Zone Name",
              "type": "string"
            },
            "enabled": {
              "title": "Enabled",
              "type": "boolean",
              "default": true
            },
            "primary": {
              "title": "Default Test Zone",
              "type": "boolean",
              "default": false
            },
            "legacyTrigger": {
              "title": "Preserve Legacy Ring Motion Pulse",
              "type": "boolean",
              "default": false
            },
            "lights": {
              "title": "Hue Lights",
              "type": "array",
              "items": {
                "title": "Light Name or ID",
                "type": "string"
              }
            },
            "brightness": {
              "title": "Zone Brightness Override (%)",
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "colorTemperature": {
              "title": "Zone White Temperature Override (mirek)",
              "type": "integer",
              "minimum": 153,
              "maximum": 500
            },
            "delaySeconds": {
              "title": "Zone Restore Delay (seconds)",
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            },
            "nightOnly": {
              "title": "Zone Night Only Override",
              "type": "boolean"
            },
            "maxOverrideSeconds": {
              "title": "Zone Maximum Override (seconds)",
              "type": "integer",
              "minimum": 60,
              "maximum": 7200
            },
            "lightSettings": {
              "title": "Per-Light-Service Motion Overrides",
              "type": "object",
              "description": "Optional motion brightness/color-temperature overrides keyed by stable Hue API v2 light service UUID. Managed automatically by the custom UI.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "brightness": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "colorTemperature": {
                    "type": "integer",
                    "minimum": 153,
                    "maximum": 500
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "brightness": {
        "title": "Default Motion Brightness (%)",
        "type": "number",
        "default": 100,
        "minimum": 1,
        "maximum": 100,
        "description": "Global default used by zones that do not specify their own brightness."
      },
      "colorTemperature": {
        "title": "Default White Temperature (mirek)",
        "type": "integer",
        "default": 200,
        "minimum": 153,
        "maximum": 500,
        "description": "Global motion white-temperature default. Lower mirek is cooler/bluer white."
      },
      "delaySeconds": {
        "title": "Default Restore Delay (seconds)",
        "type": "integer",
        "default": 90,
        "minimum": 5,
        "maximum": 3600
      },
      "nightOnly": {
        "title": "Default Night Only",
        "type": "boolean",
        "default": false,
        "description": "Global default for zones without an explicit Night Only setting."
      },
      "protectManualChanges": {
        "title": "Protect Manual Changes",
        "type": "boolean",
        "default": true,
        "description": "Do not restore over a light whose current Hue state no longer matches MotionGuard's expected override state."
      },
      "securityMode": {
        "title": "Operating Mode",
        "type": "string",
        "default": "normal",
        "enum": [
          "normal",
          "night",
          "away",
          "party"
        ],
        "enumNames": [
          "Normal",
          "Night",
          "Away",
          "Party"
        ]
      },
      "homekitProfile": {
        "title": "Apple Home Exposure",
        "type": "string",
        "default": "standard",
        "enum": [
          "minimal",
          "standard",
          "advanced"
        ],
        "enumNames": [
          "Minimal — Enabled, Pause, Motion Trigger",
          "Standard — Recommended",
          "Advanced — Add Protect, Test, Restore Now"
        ],
        "description": "Controls how many MotionGuard services are exposed inside each zone accessory in Apple Home."
      },
      "pauseDurationMinutes": {
        "title": "Pause Duration (minutes)",
        "type": "integer",
        "default": 60,
        "minimum": 5,
        "maximum": 1440,
        "description": "How long the per-zone Pause switch suspends automatic motion before resuming itself."
      },
      "latitude": {
        "title": "Latitude (optional)",
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "title": "Longitude (optional)",
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "maxOverrideSeconds": {
        "title": "Maximum Override Time",
        "type": "integer",
        "default": 600,
        "minimum": 60,
        "maximum": 7200
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false
      },
      "performanceLogging": {
        "title": "Performance Timing Logs",
        "type": "boolean",
        "default": true,
        "description": "Logs MotionGuard snapshot/read and Hue write timing for each trigger."
      }
    }
  },
  "icon": "https://raw.githubusercontent.com/Tupling/homebridge-motionguard-hue/main/branding/icon.png"
}