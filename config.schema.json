{
  "pluginAlias": "HueMotionRestore",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "### MotionGuard for Hue v0.7.0 — Fast Motion + Apple Home Controls\nPersistent Hue connections, live bridge state caching, grouped Apple Home controls, and exact pre-motion restore.",
  "footerDisplay": "Each enabled zone exposes a separate Motion Pulse automation target plus grouped MotionGuard controls in Apple Home. The legacy primary zone preserves Ring Motion Pulse and Hue Motion Restore identities.",
  "x-branding": {
    "imagePath": "branding/banner.png",
    "iconPath": "branding/icon.png",
    "image": "https://raw.githubusercontent.com/Tupling/homebridge-motionguard-hue/main/branding/banner.png",
    "icon": "https://raw.githubusercontent.com/Tupling/homebridge-motionguard-hue/main/branding/icon.png"
  },
  "x-icon": "branding/icon.png",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "bridgeHost",
      "bridgeId",
      "certificateFingerprint",
      "hueApplicationKey"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "MotionGuard for Hue"
      },
      "bridgeHost": {
        "title": "Hue Bridge Private IP",
        "type": "string",
        "placeholder": "192.168.1.25",
        "description": "Private or link-local IP address only."
      },
      "bridgeId": {
        "title": "Hue Bridge ID",
        "type": "string"
      },
      "certificateFingerprint": {
        "title": "Pinned TLS Certificate SHA-256",
        "type": "string"
      },
      "hueApplicationKey": {
        "title": "Hue Application Key",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "motionLightingEnabled": {
        "title": "Motion Lighting Enabled by Default",
        "type": "boolean",
        "default": true,
        "description": "Initial Apple Home Motion Lighting master-switch state. Apple Home changes are persisted."
      },
      "brightness": {
        "title": "Default Motion Brightness (%)",
        "type": "number",
        "default": 100,
        "minimum": 1,
        "maximum": 100
      },
      "colorTemperature": {
        "title": "Default Motion White Temperature (mirek)",
        "type": "integer",
        "default": 200,
        "minimum": 153,
        "maximum": 500,
        "description": "200 mirek is approximately 5000 K. Apple Home exposes this through the Motion Lighting white-temperature control."
      },
      "delaySeconds": {
        "title": "Default Restore Delay (seconds)",
        "type": "integer",
        "default": 90,
        "minimum": 5,
        "maximum": 3600
      },
      "nightOnly": {
        "title": "Night Only by Default",
        "type": "boolean",
        "default": false,
        "description": "Requires valid latitude and longitude. Motion is blocked when night status cannot be determined."
      },
      "protectManualChanges": {
        "title": "Protect Manual Changes by Default",
        "type": "boolean",
        "default": true,
        "description": "Before restore, verify the lights still match the motion state so a manual change is not overwritten."
      },
      "lights": {
        "title": "Legacy / Single-Zone Hue Lights",
        "type": "array",
        "description": "Backward-compatible single-zone list. The primary legacy zone preserves the existing Ring Motion Pulse accessory.",
        "items": {
          "title": "Light Name or ID",
          "type": "string"
        }
      },
      "zoneManagerVersion": {
        "title": "Zone Manager Version",
        "type": "integer",
        "default": 1
      },
      "zones": {
        "title": "Motion Lighting Zones",
        "type": "array",
        "items": {
          "title": "Zone",
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "title": "Stable Zone ID",
              "type": "string",
              "description": "Permanent internal ID used to preserve HomeKit accessory identity when the zone is renamed."
            },
            "name": {
              "title": "Zone Name",
              "type": "string"
            },
            "enabled": {
              "title": "Enabled",
              "type": "boolean",
              "default": true
            },
            "primary": {
              "title": "Default Test Zone",
              "type": "boolean",
              "default": false
            },
            "legacyTrigger": {
              "title": "Preserve Legacy Ring Motion Pulse",
              "type": "boolean",
              "default": false
            },
            "lights": {
              "title": "Hue Lights",
              "type": "array",
              "items": {
                "title": "Light Name or ID",
                "type": "string"
              }
            },
            "brightness": {
              "title": "Zone Brightness Override (%)",
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "colorTemperature": {
              "title": "Zone White Temperature Override (mirek)",
              "type": "integer",
              "minimum": 153,
              "maximum": 500
            },
            "delaySeconds": {
              "title": "Zone Restore Delay (seconds)",
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            },
            "nightOnly": {
              "title": "Zone Night Only Override",
              "type": "boolean"
            },
            "protectManualChanges": {
              "title": "Zone Protect Manual Changes Override",
              "type": "boolean"
            },
            "maxOverrideSeconds": {
              "title": "Zone Maximum Override (seconds)",
              "type": "integer",
              "minimum": 60,
              "maximum": 7200
            }
          }
        }
      },
      "latitude": {
        "title": "Latitude (optional)",
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "title": "Longitude (optional)",
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "maxOverrideSeconds": {
        "title": "Maximum Override Time",
        "type": "integer",
        "default": 600,
        "minimum": 60,
        "maximum": 7200
      },
      "performanceLogging": {
        "title": "Performance Logging",
        "type": "boolean",
        "default": false,
        "description": "Logs trigger-to-Hue timing so delays before MotionGuard can be separated from Hue command latency."
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false
      }
    }
  },
  "icon": "https://raw.githubusercontent.com/Tupling/homebridge-motionguard-hue/main/branding/icon.png"
}
