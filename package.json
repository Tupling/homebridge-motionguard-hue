{
  "name": "homebridge-hue-motion-restore",
  "version": "0.8.3",
  "description": "MotionGuard for Hue: low-latency Homebridge motion lighting with live Hue state caching, parallel writes, clean Apple Home controls, and exact state restore.",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "philips-hue",
    "homekit",
    "motion-lighting",
    "security-lighting",
    "multi-zone-lighting"
  ],
  "engines": {
    "node": ">=22.0.0 <27.0.0",
    "homebridge": ">=2.0.0 <3.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check lib/hue-client.js && node --check lib/sun.js && node --check lib/zones.js && node --check scripts/link-hue.js && node --check homebridge-ui/public/index.js && node --check homebridge-ui/server.js",
    "hue-link": "node scripts/link-hue.js",
    "security-check": "npm audit --omit=dev"
  },
  "displayName": "MotionGuard for Hue",
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6"
  },
  "author": {
    "name": "Nine 3 Digital, LLC",
    "url": "https://github.com/Tupling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tupling/homebridge-motionguard-hue.git"
  },
  "homepage": "https://github.com/Tupling/homebridge-motionguard-hue#readme",
  "bugs": {
    "url": "https://github.com/Tupling/homebridge-motionguard-hue/issues"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "homebridge-ui",
    "config.schema.json",
    "branding",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "funding": {
    "type": "custom",
    "url": "https://paypal.me/daletupling"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    {
      "name": "Dale Tupling",
      "url": "https://github.com/Tupling"
    }
  ]
}